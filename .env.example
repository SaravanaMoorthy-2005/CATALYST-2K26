# CareCircle 3.0 Public Client Environment Variables (Vercel & Local)
# These are public client configuration values (safe to expose in client bundle)
VITE_FIREBASE_API_KEY=AIzaSyFakeKeyForLocalDevelopment12345
VITE_FIREBASE_AUTH_DOMAIN=demo-carecircle.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-carecircle
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_STORAGE_BUCKET=demo-carecircle.appspot.com

# Optional client variables:
# VITE_FIREBASE_VAPID_KEY=
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# -------------------------------------------------------------------------
# SERVER-ONLY SECRETS (Do NOT prefix with VITE_, do NOT put in client bundle)
# Configure in Google Cloud Secret Manager / Firebase Functions Secrets
# -------------------------------------------------------------------------
# INVITATION_HMAC_SECRET=your-cryptographically-random-256bit-secret
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-api-key
# SMTP_FROM_ADDRESS=notifications@carecircle.health
# KMS_KEY_RESOURCE=projects/my-project/locations/global/keyRings/my-ring/cryptoKeys/my-key
