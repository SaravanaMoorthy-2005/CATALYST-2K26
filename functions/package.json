    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.4.0",
    "firebase-functions": "^6.0.1",
    "zod": "^3.23.8",
    "@carecircle/shared": "*",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.15"
  }
}
